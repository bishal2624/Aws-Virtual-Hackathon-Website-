NODE_ENV=development
PORT=4000

# Database
# Local development uses SQLite. Vercel deployments MUST use PostgreSQL.
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=
SQLITE_DB_PATH=data/hackathon.db

# PostgreSQL TLS (managed providers use valid certificates)
# Set DATABASE_SSL_CA to a PEM certificate if your provider requires one.
# Only set DATABASE_SSL=false for a local database without TLS.
DATABASE_SSL_CA=
# Set to false only for providers using self-signed certificates.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Organizer session signing. Required in production (minimum 16 characters).
# ADMIN_SESSION_SECRET is accepted as a legacy alias.
SESSION_SECRET=
PUBLIC_SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Organizer Dashboard Authentication
# Both values are required. There are no default credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Email / SMTP Configuration (Nodemailer)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 (secure TLS) or 587 (STARTTLS)
# For Gmail: SMTP_USER must be your Gmail address (e.g. user@gmail.com)
# For Gmail: SMTP_PASS must be a 16-character Google App Password (without spaces)
# SMTP_FROM should match your authenticated account (e.g. "Hack - To - ween" <user@gmail.com>)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ORGANIZER_NOTIFICATION_EMAIL=
